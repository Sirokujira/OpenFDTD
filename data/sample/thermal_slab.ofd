OpenFDTD 4 2
#
# thermal_slab.ofd — 熱解析レイヤ (発熱密度) のセル毎材料参照の検証
#
# 目的
#   sol/solve.c の calculatePowerLoss がセル毎に材料 ID (iEx..iHz) を引いて
#   σ_e / σ_m を取り出していることを外から確認する。
#   以前は材料 0 (真空) の σ を全セルに使っていたため、どんな構造を置いても
#   電界による損失は恒等的に 0 だった。
#
# 構成 (擬似 1D、x/y は PBC)
#   真空 / 導電性スラブ (εr=4, σ=0.05 S/m, 厚さ 0.4 µm) / 真空
#   -Z から平面波を入射する。周波数は 1.93414489e14 Hz (λ ≈ 1.55 µm)。
#
#   波源は waveamp で CW にする。既定のガウス微分パルスは幅が周波数設定から
#   自動決定されるため、この光学周波数帯では frequency2 の位置に十分な
#   スペクトルが乗らず、DFT の正規化 (sol/setupDft.c の cFdft による除算) が
#   破綻して近傍界 DFT が 0/NaN になる。tpa_slab.ofd が CW を使うのと同じ理由。
#
# 期待される性質 (data/sample/thermal_material_check.sh が判定する)
#   1. σ > 0 のスラブがあるので "Thermal: dissipated[0]" は正の値になる
#      (材料 0 固定だった頃は 0 のまま)
#   2. 同じ形状・同じ材料定数を別の material id に割り当てても値が一致する
#      (id そのものではなく、セルが指す材料が使われていることの確認)
#   3. スラブの σ を 0 にすると 0 に戻る
#
#   ログの値は DFT が入射スペクトルで正規化されていないため絶対的な W では
#   なく相対量。上の 3 性質はいずれも正規化に依らないので判定に使える。
#
title = thermal slab : per-cell material power loss

# 伝搬方向 (z) だけ細かく切る。x, y は 1 セル相当 (PBC)
xmesh = 0 4 0.4e-6
ymesh = 0 4 0.4e-6
zmesh = 0 10 0.4e-6 10 0.8e-6 10 1.2e-6

# id=2 : 導電性スラブ (εr=4, σ=0.05 S/m)
# id=3 : id=2 とまったく同じ材料 (別 id に置いても結果が変わらないことの確認用)
material = 1 4 0.05 1 0
material = 1 4 0.05 1 0

# 導電性スラブ : z = 0.4e-6 .. 0.8e-6 (厚さ 0.4 µm)
geometry = 2 1 0 0.4e-6 0 0.4e-6 0.4e-6 0.8e-6

planewave = 180 0 1
waveamp = 1.0e8
pbc = 1 1 0

frequency1 = 1.93414489e14 1.93414489e14 0
frequency2 = 1.93414489e14 1.93414489e14 0

solver = 1000 500 0
end
